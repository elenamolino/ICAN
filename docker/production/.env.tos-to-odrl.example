# Copy this file to docker/production/.env.tos-to-odrl on the deploy machine
# and fill in the keys the tos-to-odrl backend needs. That file is gitignored
# (see .env in .gitignore) — never commit real keys.

OPENAI_API_KEY=

# Used for the default model (Hugging Face Inference Providers router)
HF_TOKEN=

# Used for the OpenRouter model presets (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Job storage — reuses ICAN's own `mongodb` service under a separate
# database, so no second Mongo container is needed. Same root credentials
# as MONGO_INITDB_ROOT_USERNAME/PASSWORD in api/.env.production.
MONGODB_URI=mongodb://root:4dm1n@mongodb:27017
MONGODB_DB=tos_to_odrl
