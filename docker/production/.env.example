# Copy this file to docker/production/.env on the deploy machine and fill it
# in. docker compose reads it automatically for variable interpolation
# (${VAR} in docker-compose.yml) AND it's passed as a second env_file to the
# `server` service — gitignored, never commit real values.

# mongo-express (web UI at :8081/db-admin/) admin login
MONGO_EXPRESS_URL=mongodb://root:4dm1n@mongodb:27017/
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=

# Sign in with SPHERE: the client secret SPHERE's administrator generated for the
# `ican` client (same value as OIDC_ICAN_CLIENT_SECRET on the SPHERE server).
SPHERE_OIDC_CLIENT_SECRET=
