# Env for the vitest suite specifically (loaded explicitly by
# vitest.config.ts via `test.env`) -- NOT the file to copy for local dev
# setup, that's .env.testing (see README).
#
# Deliberately a SEPARATE database from dev: testApp.ts drops this database
# on every test run (mongoose.connection.db.dropDatabase()) -- if this ever
# matched dev's DATABASE_NAME, running the tests would wipe the dev
# database (it happened once, hence this file existing at all).
ENVIRONMENT=testing
DATABASE_TECHNOLOGY=mongoDB
# Separate from dev's 8080
SERVER_PORT=8081
BASE_URL_PATH=

MONGO_PROTOCOL=mongodb
MONGO_HOST=localhost
MONGO_PORT=27017
DATABASE_NAME=ican_test_db
DATABASE_USERNAME=testUser
DATABASE_PASSWORD=testUser

# Credentials consumed by api/init-mongo.sh
MONGO_INITDB_DATABASE=ican_db
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=4dm1n

# Public URLs and static folders
SERVER_HOST=http://localhost
SERVER_STATICS_FOLDER=public/
AVATARS_FOLDER=static/avatars/users/uploaded
ORG_AVATARS_FOLDER=static/avatars/orgs
COLLECTIONS_FOLDER=static/collections

# Redis cache
REDIS_URL=redis://localhost:6379

# unfair-tos-detector microservice (see docker/dev/docker-compose.yml)
ANALYZER_SERVICE_URL=http://localhost:3010

# termscockpit REST server (ToS/Privacy Policy ingestion source)
TERMSCOCKPIT_SERVICE_URL=http://localhost:5000

# tos-to-odrl microservice (ToS -> TOSL/ODRL pipeline). Runs standalone via
# its own docker-compose (own Mongo + LLM keys); not wired into ICAN's.
TOS_TO_ODRL_SERVICE_URL=http://localhost:8000

# Seeded test users
ADMIN_PASSWORD=$2a$05$su1Kqvc5EdsmVPcT1QsLcOWXZpFrWKKU/rsl8glLVWBV3gcKG/Byq
USER_PASSWORD=test

# JWT Authentication
JWT_SECRET=sphere-test-jwt-secret-m3n8p2q5
JWT_EXPIRATION=24h
# SSO UVUS (Universidad de Sevilla)
SSO_US_CAS_URL=http://localhost:9444/cas
SSO_US_CALLBACK_URL=http://localhost:8080/api/v1/users/auth/sso/us/callback
FRONTEND_URL=http://localhost:5173

# Login social con Google (OAuth2/OIDC); vacio en testing, los tests mockean la libreria
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/users/auth/sso/google/callback
