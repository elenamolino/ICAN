# Global settings
ENVIRONMENT=production
DATABASE_TECHNOLOGY=mongoDB
SERVER_PORT=8080
BASE_URL_PATH=

# MongoDB connection used inside docker compose
MONGO_PROTOCOL=mongodb
MONGO_HOST=mongodb
MONGO_PORT=27017
DATABASE_NAME=sphere_db
DATABASE_USERNAME=testUser
DATABASE_PASSWORD=testUser

# Credentials consumed by api/init-mongo.sh
MONGO_INITDB_DATABASE=sphere_db
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=4dm1n

# Public URLs and static folders
SERVER_HOST=https://ican.score.us.es
SERVER_STATICS_FOLDER=public/
AVATARS_FOLDER=static/avatars/users
ORG_AVATARS_FOLDER=static/avatars/orgs
COLLECTIONS_FOLDER=static/collections

# Redis cache
REDIS_URL=redis://redis:6379

# unfair-tos-detector microservice (contract clause classification), published
# from github.com/elenamolino/unfair-terms-detector-app to GHCR.
ANALYZER_SERVICE_URL=http://unfair-tos-detector:3000

# termscockpit REST server: not wired into docker/production yet. Set this
# once a termscockpit instance is deployed.
TERMSCOCKPIT_SERVICE_URL=

# tos-to-odrl microservice (ToS -> ODRL policy pipeline), published from
# github.com/elenamolino/AM-TOSL to GHCR. Needs its own API keys — see
# docker/production/.env.tos-to-odrl.example.
TOS_TO_ODRL_SERVICE_URL=http://tos-to-odrl-backend:8000

# Seeded production credentials
ADMIN_PASSWORD=4dm1n
USER_PASSWORD=test

# JWT Authentication
JWT_SECRET=sphere-prod-jwt-secret-r9k4m7p2
JWT_EXPIRATION=24h
# SSO UVUS (Universidad de Sevilla)
SSO_US_CAS_URL=https://sso.us.es/CAS
SSO_US_CALLBACK_URL=https://ican.score.us.es/api/v1/users/auth/sso/us/callback
FRONTEND_URL=https://ican.score.us.es

# Login social con Google (OAuth2/OIDC)
GOOGLE_CLIENT_ID=640085168966-c4vjpju6jrhuteuh0mvsrs08a3kbi64t.apps.googleusercontent.com
# No commitear el secreto (repo publico): establecerlo en el servidor.
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://ican.score.us.es/api/v1/users/auth/sso/google/callback
