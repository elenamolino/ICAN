# Example frontend settings
ENVIRONMENT=development

# Backend API base path exposed by Vite proxy or nginx.
VITE_API_URL=/api/v1

# Where the Vite dev proxy forwards /api and /static (see vite.config.ts).
# Must match SERVER_PORT in api/.env. Only needed if you're not using the
# default :8080 (e.g. it's already taken by something else locally).
# VITE_API_PROXY_TARGET=http://localhost:8081

# Client-side encryption key used by localStorage helpers.
VITE_SECRET_KEY=secret


# JWT reference (must match backend JWT_SECRET)
JWT_SECRET=sphere-dev-jwt-secret-x7k9m2p4q8r1